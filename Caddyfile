{
	auto_https off
	log {
		output stdout
		format console
		level WARN
	}
}

:80 {
	protocols h1
	root * /usr/share/caddy
	file_server

	encode gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	header /*.html Cache-Control "no-cache, no-store, must-revalidate"
	header /*.js Cache-Control "no-cache, no-store, must-revalidate"
	header /*.css Cache-Control "no-cache, no-store, must-revalidate"
	header /*.json Cache-Control "no-cache, no-store, must-revalidate"

	header /*.png Cache-Control "public, max-age=31536000"

	log {
		output stdout
		format console
		level WARN
	}
}
